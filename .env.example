# Local development env — copy to .env.development.local (gitignored):
#
#   cp .env.example .env.development.local
#
# This file points the app at the LOCAL Docker Supabase stack only.
# Never put the hosted project's URL or keys in here.

# Local API (this project uses port 54421, not Supabase's default 54321).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54421

# Fill both from `npx supabase status` after `npm run db:start`
# (ANON_KEY and SERVICE_ROLE_KEY). They are the same on every machine and
# only work against 127.0.0.1.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only despite the NEXT_PUBLIC_ prefix; read solely by createAdminClient.
NEXT_PUBLIC_SERVICE_ROLE_KEY=

# Enables /api/auth/dev-login (Google OAuth cannot reach a local stack).
# Must match the password of the accounts seeded by supabase/seed.sql.
DEV_LOGIN_PASSWORD=localdev
